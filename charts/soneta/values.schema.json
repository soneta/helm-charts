{
    "$schema": "https://json-schema.org/draft-07/schema#",
    "$defs": {
        "Quantity": {
            "oneOf": [
                { "type": "string" },
                { "type": "number" }
            ],
            "description": "A Kubernetes resource quantity, e.g. '100m', '1Gi', '42'."
        },
        "ResourceList": {
            "type": "object",
            "additionalProperties": { "$ref": "#/$defs/Quantity" },
            "description": "A map of resource names to quantities."
        },
        "resourceRequirements": {
            "type": "object",
            "properties": {
                "limits": {
                    "$ref": "#/$defs/ResourceList",
                    "description": "Maximum amount of compute resources allowed."
                },
                "requests": {
                    "$ref": "#/$defs/ResourceList",
                    "description": "Minimum amount of compute resources required."
                }
            },
            "description": "Describes the compute resource requirements."
        },
        "pvcSpec": {
            "type": "object",
            "properties": {
                "accessModes": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "List of access modes for the PVC (e.g. ReadWriteOnce, ReadOnlyMany, ReadWriteMany)"
                },
                "resources": {
                    "type": "object",
                    "properties": {
                        "requests": {
                            "type": "object",
                            "properties": {
                                "storage": { 
                                    "$ref": "#/$defs/Quantity", 
                                    "description": "Requested storage size (e.g. 10Mi, 1Gi)" }
                            },
                            "required": ["storage"]
                        }
                    },
                    "required": ["requests"]
                },
                "storageClassName": {
                    "type": "string",
                    "description": "Name of the StorageClass to use"
                },
                "selector": {
                    "type": "object",
                    "properties": {
                        "matchLabels": {
                            "type": "object",
                            "additionalProperties": { "type": "string" }
                        },
                        "matchExpressions": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "key": { "type": "string" },
                                    "operator": { "type": "string" },
                                    "values": {
                                        "type": "array",
                                        "items": { "type": "string" }
                                    }
                                },
                                "required": ["key", "operator"]
                            }
                        }
                    }
                },
                "volumeMode": {
                    "type": "string",
                    "enum": ["Filesystem", "Block"],
                    "description": "Defines whether the volume is a filesystem or block device"
                },
                "dataSource": {
                    "type": "object",
                    "properties": {
                        "name": { "type": "string" },
                        "kind": { "type": "string" },
                        "apiGroup": { "type": "string" }
                    },
                    "required": ["name", "kind"]
                },
                "dataSourceRef": {
                    "type": "object",
                    "properties": {
                        "name": { "type": "string" },
                        "kind": { "type": "string" },
                        "apiGroup": { "type": "string" }
                    },
                    "required": ["name", "kind"]
                },
                "volumeName": {
                    "type": "string",
                    "description": "Bind to a specific PersistentVolume by name"
                }
            },
            "required": ["accessModes", "resources"]
        },
        "probe": {
            "type": "object",
            "description": "Overrides for a single probe, the handler is managed by the chart.",
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "description": "Enable the probe (liveness and startup true, readiness false)."
                },
                "failureThreshold": {
                    "type": "integer",
                    "description": "Number of consecutive failures (liveness 3, startup 10, readiness 3)."
                },
                "periodSeconds": {
                    "type": "integer",
                    "description": "Probe period in seconds (default 5)."
                },
                "timeoutSeconds": {
                    "type": "integer",
                    "description": "Probe timeout in seconds (default 1)."
                }
            },
            "additionalProperties": false
        },
        "componentHealthcheck": {
            "type": "object",
            "description": "Probes configuration for a scope or a single component.",
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "description": "Enable probes in this scope (default true)."
                },
                "liveness": { "$ref": "#/$defs/probe" },
                "startup": { "$ref": "#/$defs/probe" },
                "readiness": { "$ref": "#/$defs/probe" }
            },
            "additionalProperties": false
        },
        "toleration": {
            "type": ["object", "null"],
            "description": "A pod toleration (key, operator, value, effect, tolerationSeconds). Null deletes it in a map.",
            "properties": {
                "key": { "type": "string" },
                "operator": { "type": "string", "enum": ["Exists", "Equal"] },
                "value": { "type": "string" },
                "effect": { "type": "string", "enum": ["NoSchedule", "PreferNoSchedule", "NoExecute"] },
                "tolerationSeconds": { "type": "integer" }
            }
        },
        "tolerationsLevel": {
            "description": "Pod tolerations keyed by any id (preferred). A list is deprecated.",
            "oneOf": [
                { "type": "object", "additionalProperties": { "$ref": "#/$defs/toleration" } },
                { "type": "array", "deprecated": true, "items": { "$ref": "#/$defs/toleration" } },
                { "type": "null" }
            ]
        },
        "secretData": {
            "description": "Secret data keyed by key (preferred): key: value. A list of {key, value} is deprecated.",
            "oneOf": [
                { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean", "null"] } },
                { "type": "array", "deprecated": true, "items": { "type": "object", "properties": { "key": { "type": "string" }, "value": { "type": ["string", "number", "boolean"] } } } },
                { "type": "null" }
            ]
        },
        "secret": {
            "type": ["object", "null"],
            "description": "A Kubernetes Opaque secret. Null deletes it in a map.",
            "properties": {
                "name": { "type": "string", "description": "Only in the deprecated list form (the map key is the name)." },
                "data": { "$ref": "#/$defs/secretData" }
            }
        },
        "secretsLevel": {
            "description": "Secrets keyed by name (preferred). A list of {name, data} is deprecated.",
            "oneOf": [
                { "type": "object", "additionalProperties": { "$ref": "#/$defs/secret" } },
                { "type": "array", "deprecated": true, "items": { "$ref": "#/$defs/secret" } },
                { "type": "null" }
            ]
        },
        "pvc": {
            "type": ["object", "null"],
            "description": "A PersistentVolumeClaim. Null deletes it in a map.",
            "properties": {
                "name": { "type": "string", "description": "Only in the deprecated list form (the map key is the name)." },
                "spec": { "$ref": "#/$defs/pvcSpec" }
            }
        },
        "pvcsLevel": {
            "description": "Extra PersistentVolumeClaims keyed by name (preferred). A list of {name, spec} is deprecated.",
            "oneOf": [
                { "type": "object", "additionalProperties": { "$ref": "#/$defs/pvc" } },
                { "type": "array", "deprecated": true, "items": { "$ref": "#/$defs/pvc" } },
                { "type": "null" }
            ]
        },
        "envEntry": {
            "description": "An environment variable: a scalar (string, number or boolean) becomes its value; a map takes value or valueFrom (not both); null deletes the variable inherited from an earlier level.",
            "oneOf": [
                { "type": ["string", "number", "boolean"] },
                { "type": "null" },
                {
                    "type": "object",
                    "properties": {
                        "value": { "type": ["string", "number", "boolean", "null"] },
                        "valueFrom": { "type": ["object", "null"], "description": "Kubernetes EnvVarSource" }
                    },
                    "additionalProperties": false
                }
            ]
        },
        "envLevel": {
            "description": "Environment variables of one level, keyed by name (preferred). A list of EnvVar objects is deprecated.",
            "oneOf": [
                { "type": "object", "additionalProperties": { "$ref": "#/$defs/envEntry" } },
                { "type": "array", "deprecated": true, "items": { "type": "object" } },
                { "type": "null" }
            ]
        },
        "volumeEntry": {
            "description": "A volume (spec present) or a mount (mountPath). A scalar is a mountPath on default-pvc. Fields are replaced one by one over earlier levels; null unsets a field.",
            "oneOf": [
                { "type": ["string", "number"] },
                { "type": "null" },
                {
                    "type": "object",
                    "properties": {
                        "name": { "type": ["string", "null"] },
                        "mountPath": { "type": ["string", "null"] },
                        "subPath": { "type": ["string", "null"] },
                        "spec": { "type": ["object", "null"], "description": "Kubernetes volume specification" }
                    },
                    "additionalProperties": false
                }
            ]
        },
        "volumeLevel": {
            "description": "Volumes and mounts of one level, keyed by id (preferred). A list of volume objects is deprecated.",
            "oneOf": [
                { "type": "object", "additionalProperties": { "$ref": "#/$defs/volumeEntry" } },
                { "type": "array", "deprecated": true, "items": { "type": "object" } },
                { "type": "null" }
            ]
        },
        "argsEntry": {
            "description": "A startup argument (string or number) or a list of them; null deletes the argument inherited from an earlier level.",
            "oneOf": [
                { "type": ["string", "number"] },
                { "type": "array", "items": { "type": ["string", "number"] } },
                { "type": "null" }
            ]
        },
        "argsLevel": {
            "description": "Startup arguments of one level, keyed by id (sorted within a level). A list of strings is deprecated.",
            "oneOf": [
                { "type": "object", "additionalProperties": { "$ref": "#/$defs/argsEntry" } },
                { "type": "array", "deprecated": true, "items": { "type": ["string", "number"] } },
                { "type": "null" }
            ]
        }
    },
    "type": "object",
    "title": "Values",
    "oneOf": [ 
        { "required": ["image", "dblist"] },
        { "required": ["image", "listaBazDanych"] }
    ],
    "properties": {
        "image": {
            "type": "object",
            "description": "Container image configuration, including repository, tag, product type, and postfixes for different components. Allows you to specify which components should be enabled (e.g., webapi, scheduler, webwcf). Example: product: 'standard', tag: '2504.2.4', webTagPostfix: -alpine, serverTagPostfix: -alpine, repository: ''",
            "properties": {
                "repository": {
                    "type" :"string",
                    "default": "",
                    "description": "Repository url, if empty then dockerhub"
                },
                "product": {
                    "type" :"string",
                    "default": "standard",
                    "description": "Product type, used to determine the image name",
                    "enum": ["standard", "premium"]
                },
                "tag":{
                    "type": "string"
                },
                "scheduler": {
                    "type": "boolean",
                    "default": false
                },
                "compiler": {
                    "type": "boolean",
                    "default": false
                },
                "webapi": {
                    "type": "boolean",
                    "default": false
                },
                "webwcf": {
                    "type": "boolean",
                    "default": false
                },
                "dashboard": {
                    "type": "string",
                    "default": "mcr.microsoft.com/dotnet/aspire-dashboard:13",
                    "description": "Aspire Dashboard container image used by orchestrator composition dashboard component"
                },
                "webTagpostfix": {
                    "type": "string",
                    "default": "",
                    "enum": ["-alpine", "-windowsservercore"]
                },
                "serverTagpostfix": {
                    "type": "string",
                    "default": "",
                    "enum": ["-alpine", "-windowsservercore"]
                }
            }
        },
        "dblist": {
            "type": "string",
            "description": "XML string containing database connection definitions. Used by the business logic to provide a list of databases. Example: <DatabaseCollection><MsSqlDatabase>...</MsSqlDatabase></DatabaseCollection>"
        },
        "listaBazDanych": {
            "type": "string",
            "description": "[DEPRECATED] Use 'dblist' instead. This property is obsolete and will be removed in a future release.",
            "deprecated": true
        },
        "replicaCount": {
            "type": "number",
            "description": "Number of replicas for the main container (e.g., web)."
        },

        "imagePullSecrets": {
            "type": "array",
            "description": "List of Kubernetes secrets used to pull images from private registries."
        },

        "nameOverride": {
            "type": "string",
            "description": "Overrides the default Helm release name for resources."
        },

        "fullnameOverride": {
            "type": "string",
            "description": "Overrides the full Helm release name for resources."
        },
        "adminMode": {
            "type": "boolean",
            "description": "Enables the application's admin mode."
        },
        "appsettings": {
            "type": "object",
            "description": "Object with application settings passed to ConfigMap. Allows you to provide configuration such as orchestrator.kubernetes, RoutingMethod, Logging, Telemetry, HealthCheck, etc. Example: { 'orchestrator': { 'kubernetes': { ... } }, 'RoutingMethod': 'CommHub', ... }",
            "additionalProperties": true
        },
        "service": {
            "type": "object",
            "description": "Kubernetes Service configuration for individual components, e.g., service type (NodePort, ClusterIP).",
            "properties": {
                "type": {
                    "type": "string"
                },
                "server": {
                    "type": "object",
                    "description": "Configuration for the server in the service",
                    "properties": {
                        "type": {
                            "type": "string"
                        }
                    }
                }
            }
        },

        "ingress": {
            "type": "object",
            "description": "Ingress resource configuration, including host, class, TLS, and annotations. Allows exposing the application outside the cluster.",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "host": {
                    "type": "string",
                    "description": "The host address for the ingress"
                }
            }
        },

        "nodeSelector": {
            "description": "Node selector labels (key: value) on which pods should be scheduled. An empty list is accepted for compatibility.",
            "oneOf": [
                { "type": "object", "additionalProperties": { "type": "string" } },
                { "type": "array", "deprecated": true, "maxItems": 0 }
            ]
        },

        "tolerations": {
            "description": "Pod tolerations, allowing scheduling on nodes with specific taints. A map keyed by any id (preferred); a list is deprecated.",
            "$ref": "#/$defs/tolerationsLevel"
        },
        "secrets": {
            "description": "Kubernetes Opaque secrets keyed by name (preferred). Example: { afs-secret: { data: { key: value } } }.",
            "$ref": "#/$defs/secretsLevel"
        },
        "pvcs": {
            "description": "Extra PersistentVolumeClaims keyed by name (preferred). Example: { extra: { spec: { ... } } }.",
            "$ref": "#/$defs/pvcsLevel"
        },

        "affinity": {
            "type": "object",
            "description": "Pod affinity rules, e.g., colocation preferences."
        },

        "resources": {
            "type": "object",
            "description": "Resource configuration (CPU, RAM) for individual components and PVC definition. Example: web: { limits: { cpu: '200m', memory: '256Mi' }, requests: { cpu: '50m', memory: '128Mi' } }, pvc: { spec: { ... } }",
            "properties": {
                "web": { "$ref": "#/$defs/resourceRequirements" },
                "webapi": { "$ref": "#/$defs/resourceRequirements" },
                "server": { "$ref": "#/$defs/resourceRequirements" },
                "scheduler": { "$ref": "#/$defs/resourceRequirements" },
                "compiler": { "$ref": "#/$defs/resourceRequirements" },
                "orchestrator": { "$ref": "#/$defs/resourceRequirements" },
                "router": { "$ref": "#/$defs/resourceRequirements" },
                "commhub": { "$ref": "#/$defs/resourceRequirements" },
                "dashboard": { "$ref": "#/$defs/resourceRequirements" },
                "webwcf": { "$ref": "#/$defs/resourceRequirements" },
                "admin": { "$ref": "#/$defs/resourceRequirements" },
                "pvc": {
                    "type": "object",
                    "description": "PersistentVolumeClaim configuration for the chart",
                    "properties": {
                        "spec": {
                            "$ref": "#/$defs/pvcSpec"
                        }
                    }
                }
            }
        },

        "healthcheck": {
            "type": "object",
            "description": "Kubernetes probes configuration, applied in order all -> frontend/backend -> component. Example: { backend: { startup: { failureThreshold: 30 } }, web: { readiness: { enabled: true } } }",
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "description": "Enable probes for all components (default true)."
                },
                "all": { "$ref": "#/$defs/componentHealthcheck" },
                "frontend": { "$ref": "#/$defs/componentHealthcheck" },
                "backend": { "$ref": "#/$defs/componentHealthcheck" },
                "web": { "$ref": "#/$defs/componentHealthcheck" },
                "webapi": { "$ref": "#/$defs/componentHealthcheck" },
                "webwcf": { "$ref": "#/$defs/componentHealthcheck" },
                "server": { "$ref": "#/$defs/componentHealthcheck" },
                "scheduler": { "$ref": "#/$defs/componentHealthcheck" },
                "orchestrator": { "$ref": "#/$defs/componentHealthcheck" },
                "router": { "$ref": "#/$defs/componentHealthcheck" }
            },
            "additionalProperties": false
        },

        "volumes": {
            "type": "object",
            "description": "Volumes and mounts per level (all -> frontend|backend -> component). Example: { all: { authentication: { mountPath: /auth, subPath: tokenkey, spec: { csi: { driver: file.csi.azure.com } } } } }",
            "properties": {
                "all": { "$ref": "#/$defs/volumeLevel" },
                "frontend": { "$ref": "#/$defs/volumeLevel" },
                "backend": { "$ref": "#/$defs/volumeLevel" },
                "web": { "$ref": "#/$defs/volumeLevel" },
                "webapi": { "$ref": "#/$defs/volumeLevel" },
                "webwcf": { "$ref": "#/$defs/volumeLevel" },
                "dashboard": { "$ref": "#/$defs/volumeLevel" },
                "server": { "$ref": "#/$defs/volumeLevel" },
                "scheduler": { "$ref": "#/$defs/volumeLevel" },
                "compiler": { "$ref": "#/$defs/volumeLevel" },
                "admin": { "$ref": "#/$defs/volumeLevel" },
                "orchestrator": { "$ref": "#/$defs/volumeLevel" },
                "router": { "$ref": "#/$defs/volumeLevel" },
                "commhub": { "$ref": "#/$defs/volumeLevel" }
            }
        },
        "envs": {
            "type": "object",
            "description": "Environment variables per level (all -> frontend|backend -> component). Example: { all: { TZ: Europe/Warsaw } }",
            "properties": {
                "all": { "$ref": "#/$defs/envLevel" },
                "frontend": { "$ref": "#/$defs/envLevel" },
                "backend": { "$ref": "#/$defs/envLevel" },
                "web": { "$ref": "#/$defs/envLevel" },
                "webapi": { "$ref": "#/$defs/envLevel" },
                "webwcf": { "$ref": "#/$defs/envLevel" },
                "dashboard": { "$ref": "#/$defs/envLevel" },
                "server": { "$ref": "#/$defs/envLevel" },
                "scheduler": { "$ref": "#/$defs/envLevel" },
                "compiler": { "$ref": "#/$defs/envLevel" },
                "admin": { "$ref": "#/$defs/envLevel" },
                "orchestrator": { "$ref": "#/$defs/envLevel" },
                "router": { "$ref": "#/$defs/envLevel" },
                "commhub": { "$ref": "#/$defs/envLevel" }
            }
        },
        "args": {
            "type": "object",
            "description": "Startup arguments per level (all -> frontend|backend -> component); dashboard reads only args.dashboard. Example: { web: { 10-urls: [--urls, 'http://*:8080'] } }",
            "properties": {
                "all": { "$ref": "#/$defs/argsLevel" },
                "frontend": { "$ref": "#/$defs/argsLevel" },
                "backend": { "$ref": "#/$defs/argsLevel" },
                "web": { "$ref": "#/$defs/argsLevel" },
                "webapi": { "$ref": "#/$defs/argsLevel" },
                "webwcf": { "$ref": "#/$defs/argsLevel" },
                "dashboard": { "$ref": "#/$defs/argsLevel" },
                "server": { "$ref": "#/$defs/argsLevel" },
                "scheduler": { "$ref": "#/$defs/argsLevel" },
                "compiler": { "$ref": "#/$defs/argsLevel" },
                "admin": { "$ref": "#/$defs/argsLevel" },
                "orchestrator": { "$ref": "#/$defs/argsLevel" },
                "router": { "$ref": "#/$defs/argsLevel" },
                "commhub": { "$ref": "#/$defs/argsLevel" }
            }
        }
    }
}